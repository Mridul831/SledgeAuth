# Backend API base URL (no VITE_ prefix in Streamlit)
API_BASE_URL=http://localhost:8000

# Use mock data (true) or connect to real backend (false)
USE_MOCK=true

# ElevenLabs API (voice briefing feature)
# Get your own at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_key_here

